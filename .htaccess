Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Keep the dormant Drupal installation from remaining publicly executable
# while it is retained temporarily for rollback.
<FilesMatch "\.(php|inc|install|module|profile|test|po|sh|sql|theme|tpl)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:includes|misc|modules|profiles|scripts|sites|themes|vendor)(?:/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
